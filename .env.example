# Hermes Environment Configuration Template
# Copy this file to .env and configure for your deployment environment.

# Superadmin Web Diagnostics Credentials
SUPERADMIN_USER=superadmin
SUPERADMIN_PASS=ChangeMeToAStrongPassword123!

# Device Identity & Cloud Synchronization
DEVICE_ID=pi1
DEVICE_KEY=your_secret_device_pre_shared_key
CENTER_ID=1

# Weighbridge Thresholds
MIN_WEIGHT=200.0
ANPR_SERVER_URL=http://127.0.0.1:8000/recognize

# Scale Serial UART Configuration
SERIAL_PORT=/dev/ttyAMA0
SERIAL_BAUDRATE=2400
STABILITY_DURATION=10.0
STABILITY_TOLERANCE=2.0

# RTSP / Snapshot Camera Streams
CAMERA_ANPR_1_URL=rtsp://admin:password@192.168.10.251:554/video/live?channel=1&subtype=0
CAMERA_ANPR_2_URL=rtsp://admin:password@192.168.10.252:554/video/live?channel=1&subtype=0
CAMERA_AUX_1_URL=rtsp://admin:password@192.168.10.250:554/video/live?channel=1&subtype=0

# Production Wi-Fi Fallback Credentials
WIFI_SSID=
WIFI_PASSWORD=
