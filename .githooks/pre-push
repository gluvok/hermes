#!/usr/bin/env bash
set -eo pipefail

echo "==> [pre-push] Running Ruff linter..."
uv run --locked ruff check

echo "==> [pre-push] Running Ty type checker..."
uv run --locked ty check

echo "==> [pre-push] Running Pytest suite..."
uv run --locked pytest

echo "==> [pre-push] All checks passed successfully. Pushing..."
